# Copy to .env and fill in. Do NOT commit .env.
# Load with:  set -a; source .env; set +a

# Tenant name (segment in your Workday URL)
WORKDAY_TENANT=acme_dpt1

# Workday host (no scheme). Find it in your tenant's WWS/RaaS URLs.
WORKDAY_HOST=wd2-impl-services1.workday.com

# Integration System User (ISU). "@tenant" is appended automatically if omitted.
WORKDAY_USERNAME=ISU_Security_Extract

# ISU password
WORKDAY_PASSWORD=change-me

# Optional: Workday Web Services version (defaults to v43.0)
WORKDAY_WWS_VERSION=v43.0
